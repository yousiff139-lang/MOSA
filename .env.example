# .env.example
# MOSA Smart Home Platform - Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace ALL placeholder values with real secrets
# 3. NEVER commit .env to version control (it's in .gitignore)
# 4. See docs/SECRETS_ROTATION.md for generating secure values

COMPOSE_PROJECT_NAME=mosa_system

# Network Configuration
SERVER_IP=192.168.1.110
TAILSCALE_DOMAIN=your-tailscale-domain.ts.net
TAILSCALE_IP=100.x.x.x

# PostgreSQL Database
POSTGRES_DB=mosa_db
POSTGRES_USER=mosa_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_HOST=mosa-postgres
POSTGRES_PORT=5432
# SECURITY FIX #21: Removed connection_limit from URL (configure programmatically in Prisma)
DATABASE_URL="postgresql://mosa_admin:CHANGE_ME_STRONG_PASSWORD_HERE@localhost:5432/mosa_db?schema=public"

# MQTT Broker (Mosquitto)
MQTT_HOST=mosa-mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=mosa_device
MQTT_PASSWORD=CHANGE_ME_MQTT_SECRET

# Telegram Notifications (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your_chat_id_here

# Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# Security & Cryptographic Secrets (REQUIRED)
# Generate 64-byte hex with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_HERE
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_HERE
COOKIE_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_HERE

# Admin Bootstrap PIN (First-boot only)
# Set a temporary PIN for initial admin login - MUST be changed on first login
ADMIN_BOOTSTRAP_PIN=CHANGE_ME_TEMPORARY_PIN

# Backup Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# AI Assistant (Optional)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/
BACKEND_URL=http://mosa-backend:8080

# Monitoring & System Secrets
SUPERVISOR_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET_HERE
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
WATCHTOWER_HTTP_API_TOKEN=CHANGE_ME_WATCHTOWER_TOKEN

# Development/Production Mode
NODE_ENV=production
