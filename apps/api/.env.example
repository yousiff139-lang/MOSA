# Core Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Redis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosa?schema=public"
REDIS_URL="redis://localhost:6379"

# Security Keys
JWT_SECRET="super_secret_jwt_key_change_me_in_prod"

# Email Sending (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Third-Party Integrations
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_SECRET=your_tuya_secret

# AI Settings
USE_LOCAL_LLM=false
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
OPENAI_API_KEY=sk-your_openai_key

# MQTT Broker (Used by Fastify)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=mosa-server-1
MQTT_USERNAME=mosa_admin
MQTT_PASSWORD=mosa_secret_pass
MQTT_RECONNECT_PERIOD=3000
