# .gitignore
# Specifies intentionally untracked files to ignore for MOSA project.
# Ensures sensitive data, generated mTLS certificates, and build artifacts are excluded.

.env
.env*.local
mosquitto/data/
mosquitto/log/
postgres_data/
node_modules/
.next/
dist/
build/
.turbo/
coverage/
del/

# Cryptographic Keys, mTLS Certificates & HIL Evidence
config/certs/
mosquitto/config/certs/
certs/
evidence/
*.key
*.pem
*.crt
*.csr
*.srl
*mtls_certs.h
packages/firmware/src/secrets.h
R1_Refactored/secrets.h
secrets.h

*.tsbuildinfo
.kiro/